# Database Configuration
DB_NAME=earthquake_monitor
DB_USER=earthquake_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Database URL (used by the application)
# For local development:
DATABASE_URL=postgresql+asyncpg://earthquake_user:your_password_here@localhost:5432/earthquake_monitor

# For Docker (uncomment when using docker-compose):
# DATABASE_URL=postgresql+asyncpg://earthquake_user:your_password_here@postgres:5432/earthquake_monitor

# Application Configuration
LOG_LEVEL=INFO
SYNC_INTERVAL_MINUTES=1

# USGS API Configuration
USGS_API_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
