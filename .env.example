# Database Configuration (Personal/Environment specific)

# For local development
DATABASE_URL=postgresql+asyncpg://earthquake_user:your_password_here@localhost:5432/earthquake_monitor

# Docker Database Configuration (used by docker-compose.yml for PostgreSQL container)
DB_USER=earthquake_user
DB_PASSWORD=your_password_here
DB_NAME=earthquake_monitor

# Alternative for psycopg2
# DATABASE_URL=postgresql://earthquake_user:your_password_here@localhost:5432/earthquake_monitor
